[TEMPLATE]
# Discord bot token (required)
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Command prefix (change this to customize command triggers)
BOT_PREFIX=.

# Optional: sync slash commands to this guild immediately during development
# Leave blank to sync globally (global commands can take up to an hour to appear)
DISCORD_GUILD_ID=

# Admin user ID (owner-only commands use the configured BOT_PREFIX)
SUPER_ADMIN_ID=your-discord-user-id-here
